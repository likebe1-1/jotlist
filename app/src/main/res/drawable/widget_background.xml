<?xml version="1.0" encoding="utf-8"?>
<!-- 两个组件共用的底板：极浅冷色渐变 + 1dp 描边（深浅色由颜色资源切换） -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:endColor="@color/widget_surface_end"
        android:startColor="@color/widget_surface_start" />
    <corners android:radius="@dimen/widget_corner_radius" />
    <stroke
        android:width="1dp"
        android:color="@color/widget_outline" />
</shape>
