<?xml version="1.0" encoding="utf-8"?>
<!-- 小组件底板：极浅的紫色渐变 + 1dp 描边，深浅色各一套颜色资源 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:endColor="@color/widget_surface_end"
        android:startColor="@color/widget_surface_start" />
    <corners android:radius="@dimen/widget_corner_radius" />
    <stroke
        android:width="1dp"
        android:color="@color/widget_outline" />
</shape>
