<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="TodoWidgetRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:visibility">gone</item>
    </style>

    <style name="TodoWidgetTask">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">@color/widget_text</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="TodoWidgetComplete">
        <item name="android:layout_width">30dp</item>
        <item name="android:layout_height">26dp</item>
        <item name="android:background">@drawable/todo_widget_action_background</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center</item>
        <item name="android:text">&#x2713;</item>
        <item name="android:textColor">@color/widget_complete</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
