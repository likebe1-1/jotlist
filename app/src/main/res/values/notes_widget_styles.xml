<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="NoteWidgetTitle">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">@color/widget_text</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="NoteWidgetCount">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">6dp</item>
        <item name="android:background">@drawable/note_widget_badge_background</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:gravity">center</item>
        <item name="android:minWidth">18dp</item>
        <item name="android:paddingStart">6dp</item>
        <item name="android:paddingTop">1dp</item>
        <item name="android:paddingEnd">6dp</item>
        <item name="android:paddingBottom">1dp</item>
        <item name="android:textColor">@color/note_badge_text</item>
        <item name="android:textSize">10sp</item>
    </style>

    <style name="NoteWidgetAction">
        <item name="android:layout_width">@dimen/widget_action_size</item>
        <item name="android:layout_height">@dimen/widget_action_size</item>
        <item name="android:layout_marginStart">4dp</item>
        <item name="android:background">@drawable/note_widget_action_background</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/note_accent</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="NoteWidgetRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/note_row_height</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:visibility">gone</item>
    </style>

    <style name="NoteWidgetRowText">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="NoteWidgetItemTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:ellipsize">end</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">@color/widget_text</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="NoteWidgetItemBody">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">1dp</item>
        <item name="android:ellipsize">end</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">@color/widget_secondary_text</item>
        <item name="android:textSize">10.5sp</item>
    </style>

    <style name="NoteWidgetEmptyText">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:gravity">center</item>
        <item name="android:maxLines">2</item>
        <item name="android:textColor">@color/widget_empty_text</item>
        <item name="android:textSize">11.5sp</item>
    </style>
</resources>
