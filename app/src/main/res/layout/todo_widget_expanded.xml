<?xml version="1.0" encoding="utf-8"?>
<!-- 扩展 4×4 及以上：日期 + 最多六条待办 + 底部"今天完成 N/M"进度 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:paddingStart="@dimen/widget_padding_h"
    android:paddingTop="@dimen/widget_padding_v"
    android:paddingEnd="@dimen/widget_padding_h"
    android:paddingBottom="@dimen/widget_padding_v">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/widget_header_height"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_title"
            style="@style/TodoWidgetTitle"
            android:text="@string/widget_title" />

        <TextView
            android:id="@+id/widget_count"
            style="@style/TodoWidgetCount" />

        <TextView
            android:id="@+id/widget_quick_capture"
            style="@style/TodoWidgetAction"
            android:contentDescription="@string/widget_quick_capture"
            android:text="记"
            android:textSize="13.5sp" />

        <TextView
            android:id="@+id/widget_add"
            style="@style/TodoWidgetAction"
            android:contentDescription="@string/widget_add_task"
            android:text="+" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_date"
        style="@style/TodoWidgetDate" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/widget_row_1"
            style="@style/TodoWidgetRow">

            <TextView
                android:id="@+id/widget_complete_1"
                style="@style/TodoWidgetRing" />

            <TextView
                android:id="@+id/widget_task_1"
                style="@style/TodoWidgetTask" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_row_2"
            style="@style/TodoWidgetRow">

            <TextView
                android:id="@+id/widget_complete_2"
                style="@style/TodoWidgetRing" />

            <TextView
                android:id="@+id/widget_task_2"
                style="@style/TodoWidgetTask" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_row_3"
            style="@style/TodoWidgetRow">

            <TextView
                android:id="@+id/widget_complete_3"
                style="@style/TodoWidgetRing" />

            <TextView
                android:id="@+id/widget_task_3"
                style="@style/TodoWidgetTask" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_row_4"
            style="@style/TodoWidgetRow">

            <TextView
                android:id="@+id/widget_complete_4"
                style="@style/TodoWidgetRing" />

            <TextView
                android:id="@+id/widget_task_4"
                style="@style/TodoWidgetTask" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_row_5"
            style="@style/TodoWidgetRow">

            <TextView
                android:id="@+id/widget_complete_5"
                style="@style/TodoWidgetRing" />

            <TextView
                android:id="@+id/widget_task_5"
                style="@style/TodoWidgetTask" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_row_6"
            style="@style/TodoWidgetRow">

            <TextView
                android:id="@+id/widget_complete_6"
                style="@style/TodoWidgetRing" />

            <TextView
                android:id="@+id/widget_task_6"
                style="@style/TodoWidgetTask" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_empty"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <ImageView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_widget_empty" />

            <TextView
                style="@style/TodoWidgetEmptyText"
                android:text="@string/widget_empty" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ProgressBar
            android:id="@+id/widget_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="6dp"
            android:layout_weight="1"
            android:max="100"
            android:maxHeight="6dp"
            android:minHeight="6dp"
            android:progress="0"
            android:progressBackgroundTint="@color/widget_progress_track"
            android:progressTint="@color/widget_progress_fill" />

        <TextView
            android:id="@+id/widget_footer_text"
            style="@style/TodoWidgetFooterText" />
    </LinearLayout>
</LinearLayout>
