<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/todo_widget_background"
    android:orientation="vertical"
    android:padding="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:text="@string/widget_title"
            android:textColor="@color/widget_text"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_quick_capture"
            android:layout_width="34dp"
            android:layout_height="28dp"
            android:background="@drawable/todo_widget_action_background"
            android:clickable="true"
            android:contentDescription="@string/widget_quick_capture"
            android:focusable="true"
            android:gravity="center"
            android:text="记"
            android:textColor="@color/widget_accent"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_add"
            android:layout_width="32dp"
            android:layout_height="28dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/todo_widget_action_background"
            android:clickable="true"
            android:contentDescription="@string/widget_add_task"
            android:focusable="true"
            android:gravity="center"
            android:text="+"
            android:textColor="@color/widget_accent"
            android:textSize="22sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:text="@string/widget_empty"
        android:textColor="@color/widget_secondary_text"
        android:textSize="13sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/widget_row_1"
        style="@style/TodoWidgetRow">

        <TextView
            android:id="@+id/widget_task_1"
            style="@style/TodoWidgetTask" />

        <TextView
            android:id="@+id/widget_complete_1"
            style="@style/TodoWidgetComplete" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_row_2"
        style="@style/TodoWidgetRow">

        <TextView
            android:id="@+id/widget_task_2"
            style="@style/TodoWidgetTask" />

        <TextView
            android:id="@+id/widget_complete_2"
            style="@style/TodoWidgetComplete" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_row_3"
        style="@style/TodoWidgetRow">

        <TextView
            android:id="@+id/widget_task_3"
            style="@style/TodoWidgetTask" />

        <TextView
            android:id="@+id/widget_complete_3"
            style="@style/TodoWidgetComplete" />
    </LinearLayout>
</LinearLayout>
